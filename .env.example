# ==========================================
# Configuración de Variables de Entorno
# Agente de Consulta de Proyectos - Procesa Consultores
# ==========================================

# Clave API de Google Gemini (AI Studio)
# También configurable desde la interfaz Streamlit en SQLite
GEMINI_API_KEY=AIzaSy...

# Modelo de Gemini por defecto (gemini-2.5-flash, gemini-1.5-pro, etc.)
MODEL_NAME=gemini-2.5-flash

# Temperatura del modelo (0.0 a 1.0, por defecto 0.1 para determinismo)
TEMPERATURE=0.1

# Ruta opcional a la base de datos SQLite (por defecto: data/database.sqlite)
SQLITE_DB_PATH=data/database.sqlite
